# WebSocket Configuration
# Add these to your .env.local file

# The DIAL backend WebSocket server URL (REQUIRED for proxy to work)
# Example: http://localhost:8080
DIAL_API_HOST=

# Optional: API key for DIAL backend authentication
# If DIAL backend requires authentication, provide the key here
# DIAL_API_KEY=your-api-key-here

# The URL where the WebSocket server is accessible
# If not set, defaults to the current origin (http://localhost:3000 in development)
# NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:3000

# Application URL (used as CORS fallback if WEBSOCKET_URL is not set)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.IO specific settings (optional, advanced)
# Maximum HTTP buffer size (default: 1000000 bytes)
# WEBSOCKET_MAX_BUFFER_SIZE=1000000

# Ping interval in milliseconds (default: 30000)
# WEBSOCKET_PING_INTERVAL=30000

# Ping timeout in milliseconds (default: 60000)
# WEBSOCKET_PING_TIMEOUT=60000

# Enable debug logging for Socket.IO and proxy
# DEBUG=socket.io*
